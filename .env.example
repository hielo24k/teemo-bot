# Variables de entorno para Teemo Bot
# Reemplaza los valores con tus credenciales reales y renombra este archivo a .env

# Token de tu bot de Discord (obtenido en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui

# API Key de Google Gemini (obtenida en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini a utilizar (opcional, por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
